{
  "schema_version": 3,
  "gates": [
    {
      "id": "test.complete",
      "mode": "command",
      "command": {
        "argv": [
          "cargo",
          "test",
          "--all",
          "--locked"
        ],
        "cwd": ".",
        "timeout_seconds": 1200,
        "environment": {
          "mode": "clean",
          "pass": [
            "PATH",
            "HOME",
            "TMPDIR",
            "TMP",
            "TEMP",
            "SystemRoot",
            "COMSPEC",
            "PATHEXT",
            "USERPROFILE",
            "LOCALAPPDATA"
          ]
        }
      }
    },
    {
      "id": "coverage",
      "mode": "coverage",
      "command": {
        "argv": [
          "cargo",
          "llvm-cov",
          "--all-features",
          "--workspace",
          "--locked",
          "--fail-under-lines",
          "90",
          "--lcov",
          "--output-path",
          "target/lcov.info"
        ],
        "cwd": ".",
        "timeout_seconds": 1200,
        "environment": {
          "mode": "clean",
          "pass": [
            "PATH",
            "HOME",
            "TMPDIR",
            "TMP",
            "TEMP",
            "SystemRoot",
            "COMSPEC",
            "PATHEXT",
            "USERPROFILE",
            "LOCALAPPDATA"
          ]
        }
      },
      "adapter": "lcov-v1",
      "report": "target/lcov.info",
      "operator": "\u003e",
      "threshold_percent": 89.99
    },
    {
      "id": "lint",
      "mode": "command",
      "command": {
        "argv": [
          "cargo",
          "clippy",
          "--all-targets",
          "--all-features",
          "--locked",
          "--",
          "-D",
          "warnings"
        ],
        "cwd": ".",
        "timeout_seconds": 1200,
        "environment": {
          "mode": "clean",
          "pass": [
            "PATH",
            "HOME",
            "TMPDIR",
            "TMP",
            "TEMP",
            "SystemRoot",
            "COMSPEC",
            "PATHEXT",
            "USERPROFILE",
            "LOCALAPPDATA"
          ]
        }
      }
    },
    {
      "id": "typecheck",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for typecheck"
    },
    {
      "id": "build",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for build"
    },
    {
      "id": "smoke",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for smoke"
    },
    {
      "id": "compatibility",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for compatibility"
    },
    {
      "id": "dependency",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for dependency"
    },
    {
      "id": "migration",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for migration"
    },
    {
      "id": "security",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for security"
    },
    {
      "id": "platform",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for platform"
    }
  ]
}
